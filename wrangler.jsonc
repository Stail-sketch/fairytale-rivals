{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fairytale-rivals",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "BattleRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BattleRoom"] }]
}
