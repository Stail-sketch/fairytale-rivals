{
  "name": "fairytale-rivals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "node scripts/sync-card-search-names.js",
    "build": "node scripts/build.js",
    "build:cloudflare": "node scripts/sync-card-search-names.js && node scripts/build-cloudflare.js",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "prestart": "node scripts/sync-card-search-names.js",
    "start": "node scripts/dev-server.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test tests/*.e2e.js"
  },
  "devDependencies": {
    "wrangler": "4.166.0"
  }
}
